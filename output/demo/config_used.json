{
  "input": {
    "fallback_fps": 960.0,
    "linearize": false,
    "gamma": 2.2,
    "bit_depth": 8,
    "timestamp_scale_us": 1.0
  },
  "sensor": {
    "positive_threshold": 0.2,
    "negative_threshold": 0.15,
    "log_epsilon": 0.001,
    "timestamp_resolution_us": 1,
    "refractory_period_us": 100
  },
  "simulation": {
    "interpolation": "linear",
    "backend": "vectorized"
  },
  "noise": {
    "enable_threshold_variation": true,
    "threshold_sigma": 0.02,
    "background_rate_hz": 0.02,
    "random_seed": 42
  },
  "visualization": {
    "accumulation_time_us": 5000,
    "playback_fps": 30.0,
    "overlay_opacity": 0.65,
    "output_video": "output/demo/event_video.avi",
    "display": false
  },
  "output": {
    "csv_path": "output/demo/events.csv",
    "npz_path": "output/demo/events.npz",
    "statistics_path": "output/demo/statistics.json"
  },
  "runtime": {
    "max_frames": 0,
    "progress": true
  }
}
